{
  "name": "frida-electron-bridge",
  "version": "1.0.0",
  "description": "Electron/Node.js runtime interop from Frida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frida-packages/frida-electron-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/frida-packages/frida-electron-bridge/issues"
  },
  "homepage": "https://github.com/frida-packages/frida-electron-bridge#readme",
  "keywords": [
    "frida-gum",
    "frida-gum-bridge",
    "electron",
    "node"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist/*.js",
    "/dist/*.d.ts"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc -p tests && tsc -p examples",
    "test": "injest",
    "test:esm": "injest --target fixture-esm"
  },
  "devDependencies": {
    "@frida/injest": "^0.1.0",
    "@types/frida-gum": "^18.8.2",
    "@types/node": "^22.10.2",
    "electron": "^43.4.0",
    "typescript": "^5.7.2"
  }
}
